# Copy to .env and fill in. The defaults below run the prototype as-is.

# Database — SQLite file for the prototype. Swap to a postgresql:// URL later.
DATABASE_URL="file:./dev.db"

# Auth secrets — use long random strings outside local dev.
JWT_ACCESS_SECRET="dev-access-secret-change-me-please-0123456789"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please-0123456789"
ACCESS_TOKEN_TTL_SECONDS=900       # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=604800   # 7 days

# Redis — leave blank for the in-memory store, or set a redis:// URL.
REDIS_URL=""
